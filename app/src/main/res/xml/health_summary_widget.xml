<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 健康聚合卡（HealthSummaryWidgetReceiver）的 appwidget-provider 元数据。
     resizeMode 允许双向调整，尺寸变化经 onAppWidgetOptionsChanged 重驱组合（crash-audit.md 修复 4）；
     minWidth/minHeight 走经典 70dp*N-30 折算档（4x2 取约 180x110dp），
     targetCellWidth/Height 仅 API 31+ 生效、低版本自动忽略；
     updatePeriodMillis=0 关闭系统闹钟通道（>=30 分钟钳制且冗余，更新全部交主循环直更，
     见 docs/archive/research/research-android-widget-2026-10-12.md §3.1）；
     initialLayout 必须用 Glance 库自带的 glance_default_loading_layout；
     configure（第二波）= 首建由配置页选档位并负责首刷，带 configure 后首建不走 onUpdate（研究报告坑 8），
     注意 requestPinGlanceAppWidget 钉选路径会绕过配置页。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:configure="com.xehuri.kinship.widget.WidgetConfigureActivity"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:widgetCategory="home_screen" />
