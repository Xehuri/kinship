{
  "name": "kinship-bridge",
  "version": "0.1.0",
  "description": "Loopback HTTP bridge over one Kinship dsh Session.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1 <0.2.3"
  }
}
