{
  "name": "axeuh-health-monitor-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "fetch:circuitjs": "node scripts/fetch-circuitjs.mjs",
    "dev": "node scripts/fetch-circuitjs.mjs && vite",
    "build": "node scripts/fetch-circuitjs.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:e2e": "node scripts/fetch-circuitjs.mjs && vue-tsc -b && vite build --outDir dist-e2e --emptyOutDir",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort --host 127.0.0.1",
    "build:atomic": "node scripts/fetch-circuitjs.mjs && node scripts/build-atomic.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "qa:shots": "node scripts/qa-shots.mjs",
    "qa:shots:check": "node scripts/check-shots.mjs",
    "typecheck": "vue-tsc -b --force",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@phosphor-icons/vue": "2.2.1",
    "chart.js": "^4.4.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.1",
    "leaflet": "^1.9.4",
    "lz-string": "^1.5.0",
    "mermaid": "^11.16.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^17.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.2.0"
  }
}
